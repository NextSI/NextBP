# E-mail usado no registro do Let's Encrypt (avisos de expiracao de certificado)
ACME_EMAIL=infra@exemplo.com.br

# Dominios publicos de cada ambiente. O DNS de ambos deve apontar para este
# servidor e as portas 80 e 443 precisam estar liberadas para a internet,
# senao a emissao do certificado falha.
PRODUCAO_DOMINIO=bp.exemplo.com.br
HOMOLOGACAO_DOMINIO=bp-homologacao.exemplo.com.br

# Mesmo valor de APP_PORT no .env de cada ambiente
PRODUCAO_PORTA=8080
HOMOLOGACAO_PORTA=8081
