# Tag da imagem publicada em nextsi/nextbp (ex.: 24.161.1, ou "latest")
BP_VERSION=latest

# Porta do host onde a aplicacao ficara acessivel (http://SERVIDOR:APP_PORT/)
APP_PORT=8080

# Nome da aplicacao (aparece no titulo da pagina) e URL publica usada nos
# links de e-mail
APP_NOME=NOME_DO_AMBIENTE - Next Business Process
APP_URL=https://bp-homologacao.exemplo.com.br/

# Banco de dados (compartilhado entre os containers mysql e app)
DB_NAME=next_bp
DB_USER=next_bp
DB_PASSWORD=troque_esta_senha
DB_ROOT_PASSWORD=troque_esta_senha_root
